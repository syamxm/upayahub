rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'admin_upayahub@upayahub.app';
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function backedByReport(feature, locationId, field) {
      let source = get(/databases/$(database)/documents/reports/$(feature.sourceReportId));
      return source != null
        && source.data.locationId == locationId
        && source.data.field == field
        && source.data.condition == feature.condition;
    }

    function validFeature(feature, locationId, field) {
      return feature.keys().hasOnly(['condition', 'confirmations', 'lastVerified', 'sourceReportId'])
        && feature.condition in ['usable', 'damaged', 'blocked', 'unclear', 'none']
        && feature.confirmations is int
        && feature.confirmations > 0
        && feature.lastVerified == request.time
        && feature.sourceReportId is string
        && backedByReport(feature, locationId, field);
    }

    match /locations/{locationId} {
      allow read: if signedIn();
      allow update: if signedIn()
        && changed().hasOnly(['ramp', 'elevator', 'tactilePaving', 'accessibleToilet'])
        && (!changed().hasAny(['ramp'])
          || validFeature(request.resource.data.ramp, locationId, 'ramp'))
        && (!changed().hasAny(['elevator'])
          || validFeature(request.resource.data.elevator, locationId, 'elevator'))
        && (!changed().hasAny(['tactilePaving'])
          || validFeature(request.resource.data.tactilePaving, locationId, 'tactilePaving'))
        && (!changed().hasAny(['accessibleToilet'])
          || validFeature(request.resource.data.accessibleToilet, locationId, 'accessibleToilet'));
      allow create, delete: if isAdmin();
    }

    match /reportPhotos/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporterId', 'data', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 1000000
        && get(/databases/$(database)/documents/reports/$(reportId)).data.reporterId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    function validReport() {
      let report = request.resource.data;
      return report.keys().hasOnly([
          'locationId', 'locationName', 'reporterId', 'reporterName', 'reporterPhoto',
          'featureType', 'field', 'condition', 'confidence', 'summary',
          'looksSynthetic', 'syntheticConfidence', 'needsReview', 'pending', 'hasPhoto', 'createdAt'
        ])
        && report.keys().hasAll([
          'locationId', 'reporterId', 'featureType', 'field', 'condition',
          'confidence', 'looksSynthetic', 'needsReview', 'pending', 'createdAt'
        ])
        && report.reporterId == request.auth.uid
        && report.createdAt == request.time
        && report.locationId is string
        && exists(/databases/$(database)/documents/locations/$(report.locationId))
        && report.featureType in ['ramp', 'elevator', 'tactile_paving', 'accessible_toilet', 'parking']
        && (report.field == null
          || report.field in ['ramp', 'elevator', 'tactilePaving', 'accessibleToilet'])
        && report.condition in ['usable', 'damaged', 'blocked', 'unclear']
        && report.confidence is number
        && report.confidence >= 0 && report.confidence <= 1
        && report.looksSynthetic is bool
        && report.needsReview is bool
        && report.pending is bool
        && report.needsReview == (report.looksSynthetic || report.confidence < 0.6)
        && (!('summary' in report)
          || (report.summary is string && report.summary.size() <= 300))
        && (!('locationName' in report)
          || (report.locationName is string && report.locationName.size() <= 200))
        && (!('syntheticConfidence' in report) || report.syntheticConfidence is number)
        && (!('hasPhoto' in report) || report.hasPhoto is bool)
        && (report.reporterName == null
          || (report.reporterName is string && report.reporterName.size() <= 100))
        && (report.reporterPhoto == null
          || (report.reporterPhoto is string && report.reporterPhoto.size() <= 500));
    }

    function redactsOwnIdentity() {
      return resource.data.reporterId == request.auth.uid
        && changed().hasOnly(['reporterName', 'reporterPhoto'])
        && !('reporterName' in request.resource.data)
        && !('reporterPhoto' in request.resource.data);
    }

    function promotedToMap(reportId) {
      let location = getAfter(/databases/$(database)/documents/locations/$(resource.data.locationId));
      return changed().hasOnly(['pending'])
        && request.resource.data.pending == false
        && resource.data.field != null
        && location.data[resource.data.field].sourceReportId == reportId;
    }

    match /reports/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn() && validReport();
      allow update: if signedIn() && (redactsOwnIdentity() || promotedToMap(reportId));
      allow delete: if isAdmin();
    }

    match /votes/{voteId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && voteId == request.resource.data.reportId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['reportId', 'voterId', 'value', 'createdAt'])
        && request.resource.data.voterId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.value in [1, -1]
        && exists(/databases/$(database)/documents/reports/$(request.resource.data.reportId))
        && get(/databases/$(database)/documents/reports/$(request.resource.data.reportId))
             .data.reporterId != request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    function validProfileWrite() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'photo', 'email'])
        && (!('name' in request.resource.data)
          || (request.resource.data.name is string && request.resource.data.name.size() <= 100))
        && (!('photo' in request.resource.data)
          || (request.resource.data.photo is string && request.resource.data.photo.size() <= 500));
    }

    function earnsPointsForNewReport(userId) {
      let next = request.resource.data;
      let current = resource.data;
      let source = get(/databases/$(database)/documents/reports/$(next.lastReportId));
      return next.diff(current).affectedKeys().hasOnly(['points', 'reportCount', 'lastReportId'])
        && next.points == current.get('points', 0) + 10
        && next.reportCount == current.get('reportCount', 0) + 1
        && next.lastReportId is string
        && next.lastReportId != current.get('lastReportId', '')
        && source != null
        && source.data.reporterId == userId;
    }

    function spendsPointsOnVoucher(userId) {
      let next = request.resource.data;
      let current = resource.data;
      let redemption = getAfter(/databases/$(database)/documents/users/$(userId)/redemptions/$(next.lastRedemptionId));
      return next.diff(current).affectedKeys().hasOnly(['points', 'lastRedemptionId'])
        && next.lastRedemptionId is string
        && next.lastRedemptionId != current.get('lastRedemptionId', '')
        && next.points == current.get('points', 0) - redemption.data.cost
        && next.points >= 0;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['name', 'photo'])
        && (!('name' in request.resource.data)
          || (request.resource.data.name is string && request.resource.data.name.size() <= 100))
        && (!('photo' in request.resource.data)
          || (request.resource.data.photo is string && request.resource.data.photo.size() <= 500));
      allow update: if isOwner(userId)
        && (validProfileWrite() || earnsPointsForNewReport(userId) || spendsPointsOnVoucher(userId));
      allow delete: if isOwner(userId);
    }

    function validRedemption(userId, redemptionId) {
      let redemption = request.resource.data;
      let voucher = get(/databases/$(database)/documents/vouchers/$(redemption.voucherId));
      return redemption.keys().hasOnly(['voucherId', 'partner', 'title', 'code', 'cost', 'createdAt'])
        && redemption.keys().hasAll(['voucherId', 'partner', 'title', 'code', 'cost', 'createdAt'])
        && redemption.createdAt == request.time
        && redemption.code is string && redemption.code.size() <= 20
        && voucher != null
        && redemption.partner == voucher.data.partner
        && redemption.title == voucher.data.title
        && redemption.cost == voucher.data.cost
        && getAfter(/databases/$(database)/documents/users/$(userId)).data.lastRedemptionId == redemptionId;
    }

    match /users/{userId}/redemptions/{redemptionId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validRedemption(userId, redemptionId);
      allow update, delete: if false;
    }

    match /vouchers/{voucherId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['partner', 'title', 'description', 'cost', 'createdAt'])
        && request.resource.data.keys().hasAll(['partner', 'title', 'cost', 'createdAt'])
        && request.resource.data.partner is string && request.resource.data.partner.size() <= 100
        && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && (!('description' in request.resource.data)
          || (request.resource.data.description is string && request.resource.data.description.size() <= 300))
        && request.resource.data.cost is int && request.resource.data.cost > 0
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /photoCheckLimits/{userId} {
      allow read, write: if false;
    }

    match /sosLimits/{userId} {
      allow read, write: if false;
    }

    match /helpers/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['lat', 'lng', 'updatedAt'])
        && request.resource.data.lat is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng is number
        && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(userId);
    }

    function isRequester() {
      return resource.data.requesterId == request.auth.uid;
    }

    function isAlerted() {
      return request.auth.uid in resource.data.alertedIds;
    }

    function cancelsOwnSos() {
      return isRequester()
        && changed().hasOnly(['cancelled'])
        && request.resource.data.cancelled == true;
    }

    function acceptsSos() {
      return isAlerted()
        && resource.data.helperId == null
        && resource.data.cancelled == false
        && resource.data.expiresAt > request.time
        && changed().hasOnly(['helperId', 'helperName'])
        && request.resource.data.helperId == request.auth.uid
        && (request.resource.data.helperName == null
          || (request.resource.data.helperName is string
            && request.resource.data.helperName.size() <= 100));
    }

    match /sos/{sosId} {
      allow read: if signedIn() && (isRequester() || isAlerted());
      allow update: if signedIn() && (cancelsOwnSos() || acceptsSos());
      allow create, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
