rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validFeature(feature) {
      return feature.condition in ['usable', 'damaged', 'blocked', 'unclear', 'none']
        && feature.confirmations is int
        && feature.confirmations > 0;
    }

    match /locations/{locationId} {
      allow read: if signedIn();
      allow update: if signedIn()
        && changed().hasOnly(['ramp', 'elevator', 'tactilePaving', 'accessibleToilet'])
        && (!changed().hasAny(['ramp']) || validFeature(request.resource.data.ramp))
        && (!changed().hasAny(['elevator']) || validFeature(request.resource.data.elevator))
        && (!changed().hasAny(['tactilePaving']) || validFeature(request.resource.data.tactilePaving))
        && (!changed().hasAny(['accessibleToilet']) || validFeature(request.resource.data.accessibleToilet));
      allow create, delete: if false;
    }

    match /reports/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.condition in ['usable', 'damaged', 'blocked', 'unclear'];
      allow update, delete: if false;
    }

    match /votes/{voteId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && voteId == request.resource.data.reportId + '_' + request.auth.uid
        && request.resource.data.voterId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.value in [1, -1];
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && request.resource.data.get('points', 0) <= 10;
      allow update: if isOwner(userId)
        && request.resource.data.get('points', 0) <= resource.data.get('points', 0) + 10;
      allow delete: if false;
    }
  }
}
